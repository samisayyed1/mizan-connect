  "query": "\n        UPDATE users\n           SET display_name = COALESCE($2, display_name)\n         WHERE id = $1 AND deleted_at IS NULL\n        RETURNING id, supabase_user_id, email, display_name, avatar_url,\n                  created_at, updated_at, deleted_at\n        ",

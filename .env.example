# Mizan Connect — environment configuration template.
# Copy to .env and fill in values for local development.
# Never commit .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
# development | staging | production | test
APP_ENV=development

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# pretty | json   (use json in staging/production)
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://mizan:mizan@localhost:5433/mizan_connect
DATABASE_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Supabase (identity provider)
#   - SUPABASE_URL is the public project URL, e.g. https://xxxxx.supabase.co
#   - JWKS is fetched from {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   - SUPABASE_JWT_AUDIENCE is "authenticated" for end-user tokens.
#   - Service role secret is NOT needed for Chunk 1; left blank intentionally.
#     Will be required in Chunks 2-4 for server-to-server admin operations.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins.
# Wildcard "*" is rejected at startup when auth endpoints exist.
# ---------------------------------------------------------------------------
MIZAN_CORS_ALLOWED_ORIGINS=http://localhost:1420,http://tauri.localhost

# ---------------------------------------------------------------------------
# Rate limiting (per IP, per minute)
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100

# ---------------------------------------------------------------------------
# Sentry (optional). Leaving SENTRY_DSN empty disables Sentry entirely.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# SnapTrade (Chunk 3 — broker integration)
#   Sandbox keys come from https://dashboard.snaptrade.com (free tier — same
#   API host as production, but limited to ~5 connections; some institutions
#   return mock data only).
#   CONSUMER_KEY is sensitive — keep it out of git.
# ---------------------------------------------------------------------------
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_API_BASE=https://api.snaptrade.com/api/v1
SNAPTRADE_REDIRECT_URI=http://localhost:8080/api/v1/sync/snaptrade/callback

# AES-256-GCM key for encrypting SnapTrade userSecret in Postgres.
# Decoded length must be exactly 32 bytes. Generate with:
#   openssl rand -base64 32
MIZAN_BROKER_SECRET_ENCRYPTION_KEY=

# Signing key for short-lived (10-minute) callback state JWTs.
# Decoded length must be ≥ 32 bytes. Distinct from MIZAN_TEST_JWT_SECRET.
# Generate with:
#   openssl rand -base64 32
MIZAN_SNAPTRADE_STATE_SECRET=

# ---------------------------------------------------------------------------
# Test-only — must be empty in production. Production builds reject this
# code path even if the variable is set.
# ---------------------------------------------------------------------------
MIZAN_TEST_JWT_SECRET=
